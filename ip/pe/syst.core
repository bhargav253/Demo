CAPI=2:
# SPDX-License-Identifier: Apache-2.0

name: "axon:pe:syst:0.1.0"
description: "Dual-buffered 2x2 systolic matrix-multiply prototype"

filesets:
  files_rtl:
    files:
      - rtl/syst_inf.sv
      - rtl/syst_outf.sv
      - rtl/syst_mac.sv
      - rtl/syst_eng.sv
      - rtl/syst.sv
    file_type: systemVerilogSource

  files_verilator_waiver:
    depend:
      - axon:lint:common
    files:
      - lint/syst.vlt
    file_type: vlt

  files_assertions:
    depend: [axon:prim:assert]
    files:
      - dv/assertions/syst_fifo_assert.sv
    file_type: systemVerilogSource

  files_tb:
    files:
      - dv/tb/syst_tb.sv
    file_type: systemVerilogSource

  files_fifo_tb:
    files: [dv/tb/syst_fifo_tb.sv]
    file_type: systemVerilogSource

parameters:
  TEST: {datatype: str, default: smoke, paramtype: plusarg}
  SEED: {datatype: int, default: 1, paramtype: plusarg}
  CYCLES: {datatype: int, default: 200, paramtype: plusarg}

targets:
  default:
    filesets:
      - files_rtl

  lint:
    filesets:
      - files_rtl
      - files_verilator_waiver
    flow: lint
    flow_options:
      tool: verilator
      verilator_options: [-Wall]
    toplevel: syst

  sim:
    filesets: [files_rtl, files_verilator_waiver, files_tb, files_assertions]
    flow: sim
    flow_options:
      tool: verilator
      mode: binary
      verilator_options: [--timing, --assert, --trace-fst, -DAXON_ASSERTIONS, -Wall]
    parameters: [TEST, SEED, CYCLES]
    toplevel: syst_tb

  sim_fifo:
    filesets: [files_rtl, files_verilator_waiver, files_fifo_tb, files_assertions]
    flow: sim
    flow_options:
      tool: verilator
      mode: binary
      verilator_options: [--timing, --assert, --trace-fst, -DAXON_ASSERTIONS, -Wall]
    parameters: [TEST, SEED, CYCLES]
    toplevel: syst_fifo_tb
