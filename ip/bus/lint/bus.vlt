`verilator_config

// The monolithic FIFO primitive core currently brings its simulation-only CDC
// delay helper into this multi-top lint target. Its inactive non-simulation
// branch intentionally leaves the instrumentation inputs unused.
lint_off -rule UNUSED -file "*/rtl/prim_cdc_rand_delay.sv" -match "*"
