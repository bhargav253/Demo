name: "axon:prim:fifo:0.1.0"
description: "Synchronous and asynchronous fifos"
filesets:
  files_rtl:
    depend:
      - axon:prim:assert
      - axon:prim:util
      - axon:prim:flop_2sync
      - axon:prim:sync_reqack
    files:
      - rtl/prim_fifo_async_sram_adapter.sv
      - rtl/prim_fifo_async_simple.sv
      - rtl/prim_fifo_async.sv
      - rtl/prim_fifo_sync.sv
      - rtl/prim_fifo_sync_cnt.sv
    file_type: systemVerilogSource

  files_verilator_waiver:
    depend:
      # common waivers
      - axon:lint:common
    files:
      - lint/prim_fifo.vlt
    file_type: vlt

targets:
  default:
    filesets:
      - files_rtl

  lint_sync:
    filesets:
      - files_rtl
      - files_verilator_waiver
    default_tool: verilator
    tools:
      verilator:
        lint_only: true
        verilator_options:
          - -Wall
          - -Wno-DECLFILENAME
          - -Wno-UNUSED
          - --lint-only
          - --top-module prim_fifo_sync
    toplevel: prim_fifo_sync

  lint_sync_cnt:
    filesets:
      - files_rtl
      - files_verilator_waiver
    default_tool: verilator
    tools:
      verilator:
        lint_only: true
        verilator_options:
          - -Wall
          - -Wno-DECLFILENAME
          - -Wno-UNUSED
          - --lint-only
          - --top-module prim_fifo_sync_cnt
    toplevel: prim_fifo_sync_cnt

  lint_async:
    filesets:
      - files_rtl
      - files_verilator_waiver
    default_tool: verilator
    tools:
      verilator:
        lint_only: true
        verilator_options:
          - -Wall
          - -Wno-DECLFILENAME
          - -Wno-UNUSED
          - --lint-only
          - --top-module prim_fifo_async
    toplevel: prim_fifo_async

  lint_async_simple:
    filesets:
      - files_rtl
      - files_verilator_waiver
    default_tool: verilator
    tools:
      verilator:
        lint_only: true
        verilator_options:
          - -Wall
          - -Wno-DECLFILENAME
          - -Wno-UNUSED
          - --lint-only
          - --top-module prim_fifo_async_simple
    toplevel: prim_fifo_async_simple

  lint_async_sram_adapter:
    filesets:
      - files_rtl
      - files_verilator_waiver
    default_tool: verilator
    tools:
      verilator:
        lint_only: true
        verilator_options:
          - -Wall
          - -Wno-DECLFILENAME
          - -Wno-UNUSED
          - --lint-only
          - --top-module prim_fifo_async_sram_adapter
    toplevel: prim_fifo_async_sram_adapter
