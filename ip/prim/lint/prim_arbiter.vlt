// SPDX-License-Identifier: Apache-2.0

`verilator_config

// Clock and reset on the fixed arbiter are consumed by assertion macros.
lint_off -rule UNUSED -file "*/rtl/prim_arbiter_fixed.sv" -match "*clk_i*"
lint_off -rule UNUSED -file "*/rtl/prim_arbiter_fixed.sv" -match "*rst_ni*"

// Generated tree nodes form directed level-to-level paths. Verilator's packed
// array analysis reports ordering/flattening cycles across those nodes.
lint_off -rule ALWCOMBORDER -file "*/rtl/prim_arbiter_fixed.sv" -match "*"
lint_off -rule UNOPTFLAT -file "*/rtl/prim_arbiter_fixed.sv" -match "*"
lint_off -rule UNOPTFLAT -file "*/rtl/prim_arbiter_tree.sv" -match "*"
