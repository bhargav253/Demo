// SPDX-License-Identifier: Apache-2.0

`verilator_config

// Clock and reset are consumed by assertion macros, which remain disabled in
// the current Verilator compatibility lane.
lint_off -rule UNUSED -file "*/rtl/prim_sum_tree.sv" -match "*clk_i*"
lint_off -rule UNUSED -file "*/rtl/prim_sum_tree.sv" -match "*rst_ni*"

// The linter sees the elaborated packed tree as a circular dependency even
// though every generated node is driven only by nodes from an adjacent level.
lint_off -rule UNOPTFLAT -file "*/rtl/prim_sum_tree.sv" -match "*"
