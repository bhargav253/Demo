name: "axon:prim:cdc_rand_delay:0.1.0"
description: "CDC random delay module for DV"

filesets:
  files_rtl:
    depend:
      - axon:prim:assert
    files:
      - rtl/prim_cdc_rand_delay.sv
    file_type: systemVerilogSource

  files_verilator_waiver:
    depend:
      # common waivers
      - axon:lint:common
    files:
      - lint/prim_cdc_rand_delay.vlt
    file_type: vlt

targets:
  default:
    filesets:
      - files_rtl
