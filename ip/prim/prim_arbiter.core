name: "axon:prim:arbiter:0.1.0"
description: "Fixed-priority and round-robin arbiters"

filesets:
  files_rtl:
    depend:
      - axon:prim:assert
      - axon:prim:arbiter_rr_select
      - axon:prim:util
    files:
      - rtl/prim_arbiter_fixed.sv
      - rtl/prim_arbiter_ppc.sv
      - rtl/prim_arbiter_tree.sv
    file_type: systemVerilogSource

  files_verilator_waiver:
    depend:
      - axon:lint:common
    files:
      - lint/prim_arbiter.vlt
    file_type: vlt

targets:
  default:
    filesets:
      - files_rtl

  lint_fixed:
    filesets: [files_rtl, files_verilator_waiver]
    default_tool: verilator
    tools:
      verilator:
        lint_only: true
        verilator_options: [-Wall, --lint-only, --top-module, prim_arbiter_fixed]
    toplevel: prim_arbiter_fixed

  lint_ppc:
    filesets: [files_rtl, files_verilator_waiver]
    default_tool: verilator
    tools:
      verilator:
        lint_only: true
        verilator_options: [-Wall, --lint-only, --top-module, prim_arbiter_ppc]
    toplevel: prim_arbiter_ppc

  lint_tree:
    filesets: [files_rtl, files_verilator_waiver]
    default_tool: verilator
    tools:
      verilator:
        lint_only: true
        verilator_options: [-Wall, --lint-only, --top-module, prim_arbiter_tree]
    toplevel: prim_arbiter_tree
