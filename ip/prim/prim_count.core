name: "axon:prim:count:0.1.0"
description: "Configurable saturating counter"
filesets:
  files_rtl:
    depend:
      - axon:prim:assert
    files:
      - rtl/prim_count.sv
    file_type: systemVerilogSource

  files_verilator_waiver:
    depend:
      # common waivers
      - axon:lint:common
    files:
      - lint/prim_count.vlt
    file_type: vlt

targets:
  default:
    filesets:
      - files_rtl
