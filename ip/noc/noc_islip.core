CAPI=2:
# SPDX-License-Identifier: Apache-2.0

name: "axon:noc:islip_arbiter:0.1.0"
description: "Single-iteration iSLIP input/output arbiter"

filesets:
  files_rtl:
    depend:
      - axon:prim:arbiter_rr_select
    files:
      - rtl/noc_islip_arbiter.sv
    file_type: systemVerilogSource

  files_verilator_waiver:
    depend:
      - axon:lint:common
    files:
      - lint/noc_islip_arbiter.vlt
    file_type: vlt

  files_tb:
    files:
      - dv/tb/noc_islip_arbiter_tb.sv
    file_type: systemVerilogSource

  files_coverage_config:
    tags: [coverage_exclude]
    files:
      - dv/coverage/noc_islip_arbiter_coverage.vlt
      - dv/coverage/noc_islip_arbiter_coverage.sv
      - dv/coverage/noc_islip_arbiter_coverage_main.cpp: {file_type: cppSource}
    file_type: vlt

  files_formal:
    files:
      - dv/formal/noc_islip_arbiter_formal.sv
      - dv/formal/noc_islip_arbiter.sby.j2: {file_type: sbyConfigTemplate}
    file_type: systemVerilogSource

parameters:
  AXON_WAVE_FILE:
    datatype: str
    paramtype: plusarg
    description: Optional FST path
  AXON_COVERAGE_FILE:
    datatype: str
    paramtype: plusarg
    default: coverage.dat
    description: Per-run raw coverage database
  NumPorts:
    datatype: int
    default: 4
    description: Number of input and output ports
    paramtype: vlogparam
  TEST:
    datatype: str
    default: smoke
    description: Unit test name
    paramtype: plusarg
  SEED:
    datatype: int
    default: 1
    description: Reproducible simulation seed
    paramtype: plusarg
  CYCLES:
    datatype: int
    default: 200
    description: Number of randomized arbitration cycles
    paramtype: plusarg

targets:
  default:
    filesets:
      - files_rtl

  lint:
    filesets:
      - files_rtl
      - files_verilator_waiver
    flow: lint
    flow_options:
      tool: verilator
      verilator_options:
        - -Wall
        - -Wno-DECLFILENAME
        - -Wno-UNUSED
    toplevel: noc_islip_arbiter

  sim:
    filesets:
      - files_rtl
      - files_tb
    flow: sim
    flow_options:
      tool: verilator
      mode: binary
      verilator_options:
        - --timing
        - --trace-fst
        - --assert
        - -Wall
        - -Wno-DECLFILENAME
        - -Wno-UNUSED
    parameters:
      - TEST
      - SEED
      - CYCLES
      - AXON_WAVE_FILE
    toplevel: noc_islip_arbiter_tb

  coverage:
    filesets:
      - files_rtl
      - files_tb
      - files_coverage_config
    flow: sim
    flow_options:
      tool: verilator
      mode: cc
      verilator_options:
        - --timing
        - --coverage-line
        - --coverage-toggle
        - --coverage-user
        - -Wall
        - -Wno-DECLFILENAME
        - -Wno-UNUSED
    parameters:
      - TEST
      - SEED
      - CYCLES
      - AXON_COVERAGE_FILE
    toplevel: noc_islip_arbiter_tb

  formal:
    default_tool: symbiyosys
    filesets:
      - files_rtl
      - files_formal
    parameters:
      - NumPorts=4
    tools:
      symbiyosys:
        tasknames:
          - prove
    toplevel: noc_islip_arbiter_formal

  formal_cover:
    default_tool: symbiyosys
    filesets:
      - files_rtl
      - files_formal
    parameters:
      - NumPorts=4
    tools:
      symbiyosys:
        tasknames:
          - cover
    toplevel: noc_islip_arbiter_formal

validation:
  version: 1
  description: Small control reference for the shared validation engine
  build_modes:
    lint: {target: lint, kind: target}
    sim:
      target: sim
      kind: simulation
      pass_pattern: 'PASS: [0-9]+ checks'
      wave_arg: AXON_WAVE_FILE
    coverage:
      target: coverage
      kind: simulation
      pass_pattern: 'PASS: [0-9]+ checks'
      coverage_arg: AXON_COVERAGE_FILE
  coverage_build_mode: coverage
  run_modes:
    base: {parameters: {}}
  tests:
    lint: {build_mode: lint}
    smoke: {build_mode: sim, parameters: {TEST: smoke, CYCLES: 200}}
    directed: {build_mode: sim, parameters: {TEST: directed, CYCLES: 200}}
    random: {build_mode: sim, parameters: {TEST: random, CYCLES: 200}}
  regressions:
    smoke:
      - tests: [lint, smoke]
    health: &health
      - tests: [lint, directed]
      - tests: [random]
        seeds: [1, 2, 3, 4, 5, 6, 7, 8]
    presubmit: *health
    postsubmit: *health
    nightly: *health
    coverage: *health
  limitations:
    - PASS means all selected checks passed; coverage percentages are descriptive, with no automatic closure threshold.
    - Default four-port single-iteration allocator only.
    - This simulation campaign does not run formal; the separate Stage 1 formal gate remains available.
